# =============================================================
# SHE Software Solutions — environment configuration template
# -------------------------------------------------------------
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` (it is gitignored). This file contains
# safe placeholder names ONLY — no real secrets.
# =============================================================

# PostgreSQL database connection string (server-only)
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://postgres:postgres@localhost:5432/revora_ai

# Runtime environment (server)
NODE_ENV=development

# Canonical application URL (server-side usage)
APP_URL=http://localhost:3000

# Secret used to pepper password hashes (server-only, never exposed)
# Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-in-production

# Session lifetime in seconds (default: 7 days)
SESSION_TTL_SECONDS=604800

# Rate-limit store: only "memory" is bundled. Any other value fails closed
# until a shared store is implemented. See docs/OPERATIONS.md.
RATE_LIMIT_STORE=memory

# -------------------------------------------------------------
# AI provider (server-only — never expose these to the browser)
# -------------------------------------------------------------
# OpenAI-compatible provider. Default: Groq (https://api.groq.com/openai/v1)
AI_PROVIDER=groq
AI_PROVIDER_API_KEY=
AI_MODEL=openai/gpt-oss-120b
AI_BASE_URL=https://api.groq.com/openai/v1

# -------------------------------------------------------------
# Email provider (server-only — never expose these to the browser)
# -------------------------------------------------------------
# Empty = email delivery is gated (no fabricated success).
EMAIL_PROVIDER=
EMAIL_PROVIDER_API_KEY=

# -------------------------------------------------------------
# Payment provider (server-only — never expose these to the browser)
# -------------------------------------------------------------
# Provider abstraction only; card numbers/CVV are NEVER stored.
# Empty = paid plan changes are gated (configuration-required).
PAYMENT_PROVIDER=
PAYMENT_PROVIDER_API_KEY=

# -------------------------------------------------------------
# Public variables (exposed to the browser).
# ONLY variables prefixed with NEXT_PUBLIC_* reach client code.
# -------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=SHE Software Solutions
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Isolated test database (NEVER point at production). Used only by
# scripts/verify-isolated-db.ts via TEST_DATABASE_URL.
# TEST_DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/isolated_test_db

# Playwright target for responsive/E2E (defaults to localhost).
# Never point at production unless PLAYWRIGHT_ALLOW_PROD=1 with approval.
# PLAYWRIGHT_BASE_URL=http://localhost:3000
