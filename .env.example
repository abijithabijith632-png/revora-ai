# =============================================================
# Revora AI — environment configuration template
# -------------------------------------------------------------
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` (it is gitignored). This file contains
# safe placeholder names ONLY — no real secrets.
# =============================================================

# PostgreSQL database connection string (server-only)
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://postgres:postgres@localhost:5432/revora_ai

# Runtime environment (server)
NODE_ENV=development

# Canonical application URL (server-side usage)
APP_URL=http://localhost:3000

# Secret used to pepper password hashes (server-only, never exposed)
# Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-in-production

# Session lifetime in seconds (default: 7 days)
SESSION_TTL_SECONDS=604800

# -------------------------------------------------------------
# AI provider (server-only — never expose these to the browser)
# -------------------------------------------------------------
# OpenAI-compatible provider. Default: Groq (https://api.groq.com/openai/v1)
AI_PROVIDER=groq
AI_PROVIDER_API_KEY=
AI_MODEL=llama-3.3-70b-versatile
AI_BASE_URL=https://api.groq.com/openai/v1

# -------------------------------------------------------------
# Email provider (server-only — never expose these to the browser)
# -------------------------------------------------------------
# Empty = email delivery is gated (no fabricated success).
EMAIL_PROVIDER=
EMAIL_PROVIDER_API_KEY=

# -------------------------------------------------------------
# Payment provider (server-only — never expose these to the browser)
# -------------------------------------------------------------
# Provider abstraction only; card numbers/CVV are NEVER stored.
# Empty = paid plan changes are gated (configuration-required).
PAYMENT_PROVIDER=
PAYMENT_PROVIDER_API_KEY=

# -------------------------------------------------------------
# Public variables (exposed to the browser).
# ONLY variables prefixed with NEXT_PUBLIC_* reach client code.
# -------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Revora AI
NEXT_PUBLIC_APP_URL=http://localhost:3000
